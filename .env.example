# Jira Cloud (email + API token from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Optional: official Atlassian remote MCP (OAuth is handled by Cursor)
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp

# Figma personal access token (https://www.figma.com/developers/api#access-tokens)
FIGMA_ACCESS_TOKEN=
FIGMA_MCP_URL=https://mcp.figma.com/mcp

# GitHub — https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_DEFAULT_REMOTE=origin
GITHUB_DEFAULT_BASE=main

# Cursor SDK — required for the execute + review agents
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Repo root (git) and iOS app the agent implements into
WORKSPACE_ROOT=.
IOS_APP_PATH=ios
IOS_SCHEME=MoviesApp
IOS_DESTINATION=platform=iOS Simulator,name=iPhone 16,OS=18.0
MEMORY_DIR=memory
